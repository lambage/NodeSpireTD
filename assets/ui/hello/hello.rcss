body
{
	width: 100%;
	height: 100%;
	font-family: Inter;
	font-size: 16dp;
	color: white;
	background-color: #202030;
}

#hello
{
	width: 640dp;
	margin: 40dp auto;
	padding: 24dp;
	background-color: #f5f5f5;
	color: #202030;
}

.title
{
	font-family: "Times New Roman";
	font-weight: bold;
	font-size: 36dp;
	text-align: center;
	margin-bottom: 16dp;
}

.body-inter
{
	font-family: "Inter 18pt";
	margin-bottom: 12dp;
}

.body-inter-semibold
{
	font-family: "Inter 18pt";
	font-weight: 600;
	margin-bottom: 12dp;
}

.body-roboto
{
	font-family: Roboto;
	margin-bottom: 12dp;
}

.body-times
{
	font-family: "Times New Roman";
	margin-bottom: 12dp;
}

button
{
	display: block;
	margin: 16dp auto 8dp auto;
	padding: 8dp 20dp;
	font-family: "Inter 18pt";
	font-weight: bold;
	color: white;
	background-color: #3a3ab9;
	border-radius: 6dp;
}

button:hover
{
	background-color: #5050d8;
}

#counter
{
	text-align: center;
	font-family: Roboto;
}
