body
{
	width: 100%;
	height: 100%;
	font-family: "Inter 18pt";
	color: #edf0e8;
}

#playlevel-root
{
	position: relative;
	width: 100%;
	height: 100%;
}

header
{
	position: absolute;
	left: 0;
	top: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 84dp;
	padding: 0 34dp;
	background-color: #080d0dcc;
	border-bottom: 1dp #526057;
}

.mission-title
{
	width: 70%;
}

.eyebrow, .section-kicker
{
	font-size: 11dp;
	color: #83b9a4;
}

.level-name
{
	font-family: "Times New Roman";
	font-size: 28dp;
	font-weight: bold;
	color: #f3f0df;
}

.status-chip
{
	padding: 8dp 12dp;
	font-size: 11dp;
	color: #e1bd67;
	background-color: #211d13;
	border: 1dp #69592f;
}

.match-resources
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: auto;
}

.money-value
{
	margin-right: 10dp;
	font-family: "Times New Roman";
	font-size: 20dp;
	font-weight: bold;
	color: #e1bd67;
}

.wave-hud
{
	position: absolute;
	left: 50%;
	top: 98dp;
	width: 220dp;
	margin-left: -110dp;
	padding: 10dp 16dp 12dp 16dp;
	text-align: center;
	background-color: #080d0de8;
	border: 1dp #7b6b39;
}

.wave-label { font-size: 10dp; color: #d8c88e; }
.wave-seconds { font-family: "Times New Roman"; font-size: 34dp; color: #fff3bd; }
.countdown-track { height: 4dp; background-color: #2b2a20; }
.countdown-progress { width: 100%; height: 100%; background-color: #d6b953; }

.battle-stats
{
	position: absolute;
	right: 34dp;
	top: 98dp;
	display: flex;
	flex-direction: row;
	background-color: #080d0de8;
	border: 1dp #526057;
}

.battle-stats div { width: 84dp; padding: 9dp; text-align: center; }
.battle-stats span, .battle-stats small { display: block; }
.battle-stats span { font-family: "Times New Roman"; font-size: 19dp; color: #f3f0df; }
.battle-stats small { margin-top: 2dp; font-size: 8dp; color: #83b9a4; }

.status-panel
{
	position: absolute;
	left: 34dp;
	bottom: 130dp;
	width: 390dp;
	padding: 22dp 24dp;
	background-color: #080d0de8;
	border-left: 3dp #83b9a4;
	border-top: 1dp #526057;
	border-right: 1dp #526057;
	border-bottom: 1dp #526057;
}

.status-panel h1
{
	margin: 7dp 0 5dp 0;
	font-family: "Times New Roman";
	font-size: 26dp;
	color: #f3f0df;
}

.status-panel p
{
	margin: 0 0 16dp 0;
	font-size: 13dp;
	color: #b8c1ba;
}

.progress-track
{
	width: 100%;
	height: 5dp;
	background-color: #27312d;
}

.progress-fill
{
	width: 0%;
	height: 100%;
	background-color: #83b9a4;
}

.status-actions
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 14dp;
}

#retry-button
{
	display: none;
	padding: 9dp 18dp;
	color: #edf0e8;
	background-color: #26342f;
	border: 1dp #83b9a4;
}

#start-match-button
{
	display: none;
	padding: 9dp 18dp;
	color: #edf0e8;
	background-color: #9a3f32;
	border: 1dp #d06b55;
}

#start-match-button.visible
{
	display: block;
}

#retry-button.visible
{
	display: block;
}

#ready-state
{
	display: none;
	margin-left: 12dp;
	font-size: 11dp;
	color: #54d394;
}

.hidden
{
	display: none;
}

.tower-loadout
{
	position: absolute;
	left: 50%;
	bottom: 18dp;
	width: 720dp;
	margin-left: -360dp;
	padding: 10dp 12dp 8dp 12dp;
	background-color: #080d0de8;
	border: 1dp #526057;
}

.loadout-title
{
	margin-bottom: 6dp;
	font-size: 9dp;
	text-align: center;
	color: #83b9a4;
}

.tower-slots
{
	display: flex;
	flex-direction: row;
	width: 100%;
}

.tower-slot
{
	display: block;
	width: 20%;
	height: 66dp;
	margin: 0 3dp;
	padding: 7dp 8dp;
	color: #dce4de;
	background-color: #121a18;
	border: 1dp #4f5f57;
}

.tower-slot:hover
{
	background-color: #20302a;
	border-color: #8db4a2;
}

.tower-slot.is-selected
{
	background-color: #633127;
	border-color: #e1846e;
}

.tower-slot:disabled
{
	color: #626a65;
	background-color: #101412;
	border-color: #303833;
}

.slot-key, .slot-name, .slot-cost
{
	display: block;
}

.slot-key
{
	float: left;
	font-size: 9dp;
	color: #83b9a4;
}

.slot-name
{
	margin-top: 6dp;
	font-family: "Times New Roman";
	font-size: 13dp;
	font-weight: bold;
	text-align: center;
}

.slot-cost
{
	margin-top: 3dp;
	font-size: 10dp;
	text-align: center;
	color: #e1bd67;
}

.placement-feedback
{
	height: 15dp;
	margin-top: 5dp;
	font-size: 10dp;
	text-align: center;
	color: #d98774;
}

.placement-feedback.valid
{
	color: #69d89e;
}

.tower-profile
{
	position: absolute;
	right: 34dp;
	top: 184dp;
	width: 390dp;
	max-height: 560dp;
	padding: 18dp;
	background-color: #080d0df2;
	border: 1dp #526057;
	border-top: 3dp #d0aa4f;
}

.profile-heading { display: flex; flex-direction: row; align-items: center; }
.profile-heading > div { width: 90%; }
.profile-heading h2 { margin: 4dp 0 0 0; font-family: "Times New Roman"; font-size: 24dp; color: #f3f0df; }
.icon-button { width: 32dp; height: 32dp; padding: 0; color: #d7ddd8; background-color: #1b2421; border: 1dp #526057; }
.tower-bio { margin: 10dp 0; font-size: 11dp; color: #aeb9b2; }
.tower-stats { display: flex; flex-direction: row; border-top: 1dp #38453f; border-bottom: 1dp #38453f; }
.tower-stats div { width: 25%; padding: 8dp 3dp; text-align: center; }
.tower-stats small, .tower-stats span { display: block; }
.tower-stats small { font-size: 7dp; color: #83b9a4; }
.tower-stats span { margin-top: 3dp; font-size: 12dp; color: #f3f0df; }
.tower-details { padding: 8dp 0; }
.tower-details span { display: block; margin: 2dp 0; font-size: 9dp; color: #9eaaa2; }
.tower-tech-tree { margin-top: 12dp; }
.tree-title { margin-bottom: 9dp; font-size: 9dp; color: #d0aa4f; text-align: center; }
.tech-tree { position: relative; }
.tech-row { display: flex; flex-direction: row; justify-content: center; }
.branch-row { display: flex; flex-direction: row; justify-content: space-between; }
.branch-column { width: 31%; }
.tech-node
{
	width: 100%;
	min-height: 62dp;
	margin-bottom: 7dp;
	padding: 6dp;
	font-size: 9dp;
	color: #dce4de;
	background-color: #17201d;
	border: 1dp #53635b;
}
.tech-node img { width: 28dp; height: 28dp; margin: 0 auto 3dp auto; display: block; }
.tech-node span { display: block; text-align: center; }
.tech-node:hover { background-color: #26342f; }
.tech-node.is-unlocked { background-color: #214c35; border-color: #57bb79; }
.tech-node:disabled { color: #717a74; background-color: #111614; border-color: #343d38; }
.core-node { border-color: #b38b37; }
.stone-node { border-color: #866b52; }
.metal-node { border-color: #8f9a9e; }
.electric-node { border-color: #4da7b8; }
.hybrid-node { border-color: #b08a66; background-color: #29251f; }
.tree-link { width: 1dp; height: 10dp; margin: 0 auto; background-color: #7c856f; }
.branch-line { width: 68%; height: 1dp; margin: 9dp auto; background-color: #7c856f; }
.empty-tree { font-size: 10dp; color: #7f8a83; text-align: center; }

#pause-menu, .pause-shade
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#pause-menu
{
	z-index: 20;
}

.pause-shade
{
	background-color: #020504b8;
}

.pause-panel
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 500dp;
	margin-left: -250dp;
	margin-top: -210dp;
	padding: 28dp;
	background-color: #0b1110f5;
	border: 1dp #66786e;
	border-left: 3dp #83b9a4;
}

.pause-panel h2
{
	margin: 6dp 0 4dp 0;
	font-family: "Times New Roman";
	font-size: 30dp;
	color: #f3f0df;
}

.pause-panel p
{
	margin: 0 0 20dp 0;
	font-size: 12dp;
	color: #9da9a1;
}

.setting-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin: 12dp 0;
}

.setting-row label
{
	width: 35%;
	font-size: 13dp;
}

.setting-row input
{
	width: 50%;
}

.setting-row span
{
	width: 15%;
	font-size: 12dp;
	text-align: right;
	color: #83b9a4;
}

.pause-actions
{
	display: flex;
	flex-direction: row;
	margin-top: 24dp;
}

.pause-actions button
{
	width: 50%;
	padding: 11dp 14dp;
	color: #edf0e8;
	background-color: #26342f;
	border: 1dp #738c7f;
}

.pause-actions .danger-button
{
	margin-left: 10dp;
	color: #f2c4ba;
	background-color: #3a1d19;
	border-color: #a85d4e;
}

#ready-state.visible
{
	display: block;
}

.hud-edge
{
	position: absolute;
	top: 84dp;
	width: 1dp;
	height: 38%;
	background-color: #83b9a455;
}

.left-edge
{
	left: 18dp;
}

.right-edge
{
	right: 18dp;
}
