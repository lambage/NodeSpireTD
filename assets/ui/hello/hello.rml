<rml>
<head>
	<title>NodeSpireTD - RmlUi Hello World</title>
	<link type="text/rcss" href="hello.rcss"/>
	<script>
		local click_count = 0

		function OnGreetClick(event, element, document)
			click_count = click_count + 1
			document:GetElementById("counter").inner_rml = "Clicked " .. click_count .. " time(s)"
		end
	</script>
</head>
<body>
	<div id="hello">
		<div class="title">Hello, RmlUi!</div>
		<p class="body-inter">Lorem ipsum dolor sit amet, consectetur adipiscing elit. This paragraph is set in Inter Regular, the default body font.</p>
		<p class="body-inter-semibold">Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. This paragraph is set in Inter SemiBold.</p>
		<p class="body-roboto">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. This paragraph is set in Roboto.</p>
		<p class="body-times">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. This paragraph is set in italic Times New Roman.</p>
		<button onclick="OnGreetClick(event, element, document)">Click me</button>
		<p id="counter">Clicked 0 time(s)</p>
	</div>
</body>
</rml>
