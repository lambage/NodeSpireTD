body
{
	width: 100%;
	height: 100%;
	background-color: #000000;
}

#splash-root
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
}

#splash-image
{
	max-width: 80%;
	max-height: 70%;
}

#splash-status
{
	position: absolute;
	bottom: 32dp;
	width: 100%;
	text-align: center;
	font-family: "Inter 18pt";
	font-size: 18dp;
	color: #cccccc;
}
